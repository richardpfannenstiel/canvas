{
  "name": "canvas-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server behind the canvas plugin: iOS Simulator and Android emulator control.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/canvas.mjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && npx @modelcontextprotocol/inspector node dist/canvas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
